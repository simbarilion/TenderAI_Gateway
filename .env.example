# Общие настройки процесса
APP_NAME=TenderAI_Gateway
DEBUG=false
ALLOWED_HOSTS=fill_allowed_hosts
ALLOWED_URLS=fill_allowed_urls
LOG_LEVEL=INFO

# PostgreSQL
# В docker compose сервис api сам подставляет DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=tenderai
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tenderai

# Redis
REDIS_URL=redis://localhost:6379/0

# Серверный ключ LLM. Groq: https://console.groq.com/keys
XAI_API_KEY=
XAI_BASE_URL=https://api.groq.com/openai/v1
XAI_MODEL=openai/gpt-oss-20b
HTTP_TIMEOUT_SECONDS=30

# Лимит Gateway: 5 запросов пользователя за 60 секунд
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Пользовательский API-ключ для аутентификации в приложении
API_KEY=after_seed_command_fill_api_key
